# MONIRESH - Environment
# Copy to .env.local for local dev, and set these in Vercel → Settings → Environment Variables
# NEVER commit real values

# --- App ---
NEXT_PUBLIC_APP_URL=https://moniresh.vercel.app

# --- Storage: choose ONE (Supabase recommended) ---
# SUPABASE (recommended for MONIRESH: Postgres + Auth + Storage + pgvector + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # anon, public, RLS enforced
SUPABASE_SERVICE_ROLE_KEY=eyJ... # server only, never expose to client

# FIREBASE (alternative if you already use Firebase)
# NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=moniresh.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=moniresh
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=moniresh.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456
# NEXT_PUBLIC_FIREBASE_APP_ID=1:xxx:web:xxx

# --- AI Gateway: White → Pink → Intelligence ---
# All three are routed via lib/ai-gateway.ts - set any one to start, add others for failover
OPENROUTER_API_KEY=sk-or-v1-... # OpenRouter - 1 key → 200+ models (Claude, GPT-4o, Gemini). Get at https://openrouter.ai/keys
HUGGINGFACE_API_KEY=hf_... # Hugging Face - embeddings + batch screening cheap. Get at https://huggingface.co/settings/tokens
NVIDIA_API_KEY=nvapi-... # NVIDIA NIM - ultra-fast Llama/Nemotron + NV-Embed. Get at https://build.nvidia.com/

# Optional: direct provider fallback
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Vector ---
PINECONE_API_KEY=... # only if you use Pinecone instead of Supabase pgvector
PINECONE_INDEX=moniresh-papers
