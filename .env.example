# MONIRESH — Environment (never commit real values)
# Copy to .env.local and fill

# Supabase (primary DB + Auth + Storage) — recommended for MONIRESH
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... # server only, never expose

# Alternative: Firebase if you choose it instead of Supabase
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# AI — model router
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=...

# Vector (if using Pinecone separate from pgvector)
PINECONE_API_KEY=
PINECONE_INDEX=moniresh-papers

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
